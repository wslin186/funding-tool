# funding-tool Web UI environment file
#
# Deploy to: /etc/funding-tool/web.env
# Owner/mode: chown root:funding /etc/funding-tool/web.env && chmod 640
#
# The master encryption key is NOT in this file — it's delivered to the
# process via systemd LoadCredential (see funding-tool-web.service).
#
# Variables here are exactly what src/funding_tool/web/config.py reads.
# Adding undefined FUNDING_* variables here has no effect.

# Public origin (must be https://) — used for strict CSRF Origin/Referer checks.
FUNDING_PUBLIC_ORIGIN=https://example.com

# HTTP Basic Auth credentials.
# Username is plaintext; password is stored as a bcrypt hash ($2b$... format).
# Generate the hash with: scripts/deploy_web.sh hash-password
# (or any bcrypt tool with cost factor >= 12)
FUNDING_AUTH_USER=admin
FUNDING_AUTH_PASSWORD_HASH=$2b$12$REPLACE_ME_WITH_A_REAL_BCRYPT_HASH

# Persistent state paths — all under /var/lib (writable per ReadWritePaths).
FUNDING_DB_PATH=/var/lib/funding-tool/secrets.sqlite
FUNDING_TASKS_DIR=/var/lib/funding-tool/tasks

# Audit log path — JSON lines, rotated externally by logrotate.
FUNDING_AUDIT_LOG_PATH=/var/log/funding-tool/audit.jsonl

# --- Not yet env-configurable (hardcoded in the application) ----------------
# The following limits are currently hardcoded; documented here so operators
# know what the running system enforces. Move to env if/when the code reads them.
#
# Auth lockout:       5 failures per IP, 300 s lockout window
#                     (src/funding_tool/web/auth.py: lockout_max=5, lockout_secs=300)
# Backtest range cap: 730 days
#                     (src/funding_tool/web/routes/backtest.py: _MAX_RANGE_DAYS=730)
# History range cap:  1095 days
#                     (src/funding_tool/web/routes/history.py: _MAX_RANGE_DAYS=1095)
