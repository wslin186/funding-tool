# funding-tool Web UI — FastAPI on 127.0.0.1:8001 behind nginx reverse proxy.
#
# Master key is delivered via systemd LoadCredential (NEVER via EnvironmentFile).
# EnvironmentFile carries only non-secret config + a bcrypt hash (not the password).
[Unit]
Description=funding-tool Web UI (FastAPI on 127.0.0.1:8001)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=funding
Group=funding
WorkingDirectory=/opt/funding-tool
EnvironmentFile=/etc/funding-tool/web.env
LoadCredential=master_key:/etc/funding-tool/master.key
LoadCredential=master_key_prev:/etc/funding-tool/master.key.prev
ExecStart=/opt/funding-tool/.venv/bin/uvicorn funding_tool.web.main:app \
          --host 127.0.0.1 --port 8001 --workers 1 --no-access-log
Restart=on-failure
RestartSec=3s

# hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/funding-tool /var/log/funding-tool

# uvicorn does not sd_notify, so disable active watchdog and rely on Restart=on-failure
TimeoutStartSec=20s
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
